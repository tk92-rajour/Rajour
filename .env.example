# Kopiér til .env og udfyld. .env må ALDRIG committes eller deles.

# --- Server ---
HOST=0.0.0.0
PORT=8080
TZ=Europe/Copenhagen
# Afvis forespørgsler fra offentlige IP-adresser (true anbefales)
LAN_ONLY=true
# Mappe til cache af sidst kendte (aggregerede) tal
CACHE_DIR=./data
LOG_LEVEL=info

# --- Datakilder ---
# demo | sagssystem
CASE_SOURCE=demo
# demo | economic
REVENUE_SOURCE=demo

# Sagssystem (read-only bruger med kun SELECT på rapporterings-view)
# Fx postgres://kpi_laeser:***@sagsserver:5432/sager  — format afhænger af databasetype
CASE_DB_URL=

# e-conomic REST API (kun læseadgang). Findes under "Apps" i e-conomic.
ECONOMIC_APP_SECRET_TOKEN=
ECONOMIC_AGREEMENT_GRANT_TOKEN=

# --- Opdatering og visning ---
# Hvor ofte serveren henter fra kilderne (sek., 120–300 anbefales)
REFRESH_SECONDS=180
# Hvor ofte browseren spørger serveren (sek.)
CLIENT_POLL_SECONDS=60
# Vis advarsel når tallene er ældre end (min.)
STALE_AFTER_MINUTES=15
# Skift mellem I dag / Denne uge / Denne måned på storskærm (sek.). 0 = fra.
TV_ROTATION_SECONDS=30
