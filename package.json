{
  "name": "kpi-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Internt KPI-dashboard for inkasso- og detektivvirksomhed",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --target=node20 --outfile=dist/server/index.js",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "date-fns": "^4.4.0",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "chart.js": "^4.5.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
